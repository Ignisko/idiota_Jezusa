---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Articles" lang="en">
	<h1>All Articles</h1>
	
	<p style="margin-bottom: 2rem;">
		A collection of my writings, guides, and resources.
	</p>
	
	<ul class="project-list" role="list">
		<li class="project-card">
			<div class="project-header">
				<a href="/indulgences" class="cactus-link project-title">📜 Indulgences</a>
			</div>
			<span class="project-desc">A guide to Catholic indulgences and an interactive calendar to discover which special plenary indulgence is available today.</span>
			<div class="project-tags">
				<span class="tag">guide</span>
				<span class="tag">faith</span>
			</div>
		</li>
		<li class="project-card">
			<div class="project-header">
				<a href="/eucharystia" class="cactus-link project-title">✝ Holy Mass & the Eucharist</a>
			</div>
			<span class="project-desc">Quotes from the Saints on Holy Mass and Communion, St. Faustina's Diary, and a practical guide on how to prepare and how to give thanks after receiving Communion.</span>
			<div class="project-tags">
				<span class="tag">faith</span>
				<span class="tag">eucharist</span>
			</div>
		</li>
	</ul>
</Layout>
