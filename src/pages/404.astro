---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Not Found" lang="en" hideNav={true} hideHeader={true}>
	<div class="flex flex-col items-center justify-center text-center px-4">
		<img 
			src="/images/404-dino-jesus.png" 
			alt="8-bit pixel art of Jesus Christ walking alongside the Chrome offline dinosaur" 
			class="mx-auto image-pixelated"
			style="max-width: 180px; width: 100%; height: auto; image-rendering: pixelated; border-radius: 8px; margin-bottom: 1rem;"
		/>
		
		<h1 style="font-size: 2.5rem; margin-bottom: 0.5rem; margin-top: 0;">Error 404</h1>
		<p style="font-size: 1.1rem; margin-bottom: 1.5rem; line-height: 1.4;">
			Just like the tomb on the third day, this page is empty! <br/>
			<span style="opacity: 0.7; font-size: 0.9rem;">Jesus leaves the 99 to find you, but even He couldn't find this link.</span>
		</p>
		
		<a href="/" class="cactus-link" style="font-size: 1.1rem; opacity: 0.8; font-weight: bold;">
			← Go Home
		</a>
	</div>
</Layout>
