---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home" lang="en">
	<h1>Jesus, i trust in You</h1>
	
	<p style="margin-bottom: 2rem;">
		hi, i'm Ignacy, based in Poland, focused on developing my faith and sharing love to Jesus.
	</p>
	
	<h2>Check out my projects:</h2>
	
	<ul class="project-list" role="list">
		<li class="project-card">
			<div class="project-header">
				<a href="https://caleb-eta.vercel.app/" target="_blank" class="cactus-link project-title">📊 CALEB</a>
				<span class="project-status status-beta">Beta</span>
			</div>
			<span class="project-desc">Catholic Atlas of Longitudinal Ecclesiology & Benchmarks.</span>
			<div class="project-tags">
				<span class="tag">react</span>
				<span class="tag">data-viz</span>
				<span class="tag">atlas</span>
			</div>
		</li>
		<li class="project-card">
			<div class="project-header">
				<a href="https://stellamaris.help/" target="_blank" class="cactus-link project-title">⭐ Stella Maris</a>
				<span class="project-status status-live">Live</span>
			</div>
			<span class="project-desc">Atlas of Marian Apparitions across the globe.</span>
			<div class="project-tags">
				<span class="tag">leaflet</span>
				<span class="tag">react</span>
				<span class="tag">atlas</span>
			</div>
		</li>
		<li class="project-card">
			<div class="project-header">
				<a href="https://road2wyd.com/" target="_blank" class="cactus-link project-title">🗺️ World Youth Day Map</a>
				<span class="project-status status-live">Live</span>
			</div>
			<span class="project-desc">Visualized history of WYD across decades and continents.</span>
			<div class="project-tags">
				<span class="tag">leaflet</span>
				<span class="tag">data-viz</span>
				<span class="tag">atlas</span>
			</div>
		</li>
		<li class="project-card">
			<div class="project-header">
				<a href="http://eucharisticmiracles.info/" target="_blank" class="cactus-link project-title">🥖 Eucharistic Miracles</a>
				<span class="project-status status-live">Live</span>
			</div>
			<span class="project-desc">Explore real, documented Eucharistic miracles from around the world. Inspired by Saint Carlo Acutis.</span>
			<div class="project-tags">
				<span class="tag">leaflet</span>
				<span class="tag">miracles</span>
			</div>
		</li>
		<li class="project-card">
			<div class="project-header">
				<a href="https://www.afoolforjesus.org/missa" target="_blank" class="cactus-link project-title">🌍 Missa</a>
				<span class="project-status status-live">Live</span>
			</div>
			<span class="project-desc">Map-based adoration of the Global Eucharistic Presence.</span>
			<div class="project-tags">
				<span class="tag">leaflet</span>
				<span class="tag">prayer</span>
				<span class="tag">atlas</span>
			</div>
		</li>
		<li class="project-card">
			<div class="project-header">
				<a href="https://pelegrin.cloud/" target="_blank" class="cactus-link project-title">✝️ Pelegrin</a>
				<span class="project-status status-live">Live</span>
			</div>
			<span class="project-desc">App for Catholic pilgrims to connect, navigate events, and deepen their faith journey.</span>
			<div class="project-tags">
				<span class="tag">app</span>
				<span class="tag">community</span>
			</div>
		</li>
		<li class="project-card">
			<div class="project-header">
				<a href="https://www.afoolforjesus.org/rosarium" target="_blank" class="cactus-link project-title">📿 Rosarium</a>
				<span class="project-status status-wip">WIP</span>
			</div>
			<span class="project-desc">Rosary guide to interactively pray and contemplate the mysteries.</span>
			<div class="project-tags">
				<span class="tag">prayer</span>
				<span class="tag">interactive</span>
			</div>
		</li>
		<li class="project-card">
			<div class="project-header">
				<a href="https://bibbia-rete.vercel.app/" target="_blank" class="cactus-link project-title">📖 Bibbia rete</a>
				<span class="project-status status-beta">Beta</span>
			</div>
			<span class="project-desc">Interactive networks of Biblical characters based on the Douay-Rheims translation.</span>
			<div class="project-tags">
				<span class="tag">data-viz</span>
				<span class="tag">scripture</span>
			</div>
		</li>
		<li class="project-card">
			<div class="project-header">
				<a href="https://www.afoolforjesus.org/ecclesia" target="_blank" class="cactus-link project-title">⛪ Ecclesia</a>
				<span class="project-status status-wip">WIP</span>
			</div>
			<span class="project-desc">Atlas of the global Catholic Church and its organizational structure (Work in progress).</span>
			<div class="project-tags">
				<span class="tag">leaflet</span>
				<span class="tag">atlas</span>
			</div>
		</li>
		<li class="project-card">
			<div class="project-header">
				<a href="https://www.afoolforjesus.org/papaya" target="_blank" class="cactus-link project-title">✞ Saints Catalogue</a>
				<span class="project-status status-beta">Beta</span>
			</div>
			<span class="project-desc">An inspiring and comprehensive catalogue of saints.</span>
			<div class="project-tags">
				<span class="tag">archive</span>
				<span class="tag">saints</span>
			</div>
		</li>
	</ul>
</Layout>

