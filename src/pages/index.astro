---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home" lang="en">
	<h1>Jesus, I Trust in You</h1>
	
	<p style="margin-bottom: 2rem;">
		hi, I'm Ignacy from Cracow, based in Warsaw, Poland, focused on developing my faith and sharing love to Jesus.
	</p>
	
	<h2>Check out my projects:</h2>
	
	<ul class="list-inside list-disc" role="list" style="margin-top: 2rem;">
		<li>
			<a href="/map/" class="cactus-link">🗺️ World Youth Day Map</a><br/>
			<span class="project-desc">An interactive journey through the history of WYD across decades and continents.</span>
		</li>
		<li>
			<a href="https://stellamaris.help/" target="_blank" class="cactus-link">⭐ Stella Maris</a><br/>
			<span class="project-desc">A comprehensive atlas of Marian Apparitions across the globe.</span>
		</li>
		<li>
			<a href="http://eucharisticmiracles.info/" target="_blank" class="cactus-link">🥖 Eucharistic Miracles</a><br/>
			<span class="project-desc">Documented Eucharistic miracles from around the world. Inspired by Saint Carlo Acutis.</span>
		</li>
	</ul>
</Layout>
