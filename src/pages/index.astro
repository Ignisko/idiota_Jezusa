---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home" lang="en">
	<h1>Jesus, I Trust in You</h1>
	
	<p style="margin-bottom: 2rem;">
		Hi, I'm Ignacy, a Catholic from Cracow based in Warsaw, Poland, focused on developing my faith and sharing love to Jesus.
	</p>
	
	<h2 class="title" style="margin-top: 4rem; color: var(--text); font-size: 1rem;">Check out my other projects:</h2>
	
	<ul style="list-style-type: none; padding-left: 0; margin-top: 2rem;">
		<li>
			<a href="/map/" style="font-size: 1.4rem;">🗺️ World Youth Day Map</a>
			<span class="project-desc">An interactive journey through the history of WYD across decades and continents.</span>
		</li>
		<li>
			<a href="https://stellamaris.help/" target="_blank" style="font-size: 1.4rem;">⭐ Stella Maris</a>
			<span class="project-desc">A comprehensive atlas of Marian Apparitions across the globe.</span>
		</li>
		<li>
			<a href="http://eucharisticmiracles.info/" target="_blank" style="font-size: 1.4rem;">🥖 Eucharistic Miracles</a>
			<span class="project-desc">Documented Eucharistic miracles from around the world. Inspired by Blessed Carlo Acutis.</span>
		</li>
	</ul>
</Layout>
