---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home" lang="en">
	<h1>Jesus, I Trust in You</h1>
	
	<p style="margin-bottom: 2rem;">
		hi, i'm Ignacy, based in Poland, focused on developing my faith and sharing love to Jesus.
	</p>
	
	<h2>Check out my projects:</h2>
	
	<ul class="list-inside list-disc" role="list" style="margin-top: 2rem;">
		<li>
			<a href="https://road2wyd.com/" target="_blank" class="cactus-link">🗺️ World Youth Day Map</a><br/>
			<span class="project-desc">an interactive journey through the history of WYD across decades and continents.</span>
		</li>
		<li>
			<a href="https://stellamaris.help/" target="_blank" class="cactus-link">⭐ Stella Maris</a><br/>
			<span class="project-desc">a comprehensive atlas of Marian Apparitions across the globe.</span>
		</li>
		<li>
			<a href="http://eucharisticmiracles.info/" target="_blank" class="cactus-link">🥖 Eucharistic Miracles</a><br/>
			<span class="project-desc">documented Eucharistic miracles from around the world. Inspired by Saint Carlo Acutis.</span>
		</li>
		<li>
			<a href="https://www.idiotajezusa.pl/papaya" target="_blank" class="cactus-link">✞ Saints Catalogue</a><br/>
			<span class="project-desc">a comprehensive catalogue of saints.</span>
		</li>
		<li>
			<a href="https://pelegrin.cloud/" target="_blank" class="cactus-link">✝️ Pelegrin</a><br/>
			<span class="project-desc">the app for Catholic pilgrims. Connect, navigate events, and deepen your faith journey.</span>
		</li>
		<li>
			<a href="https://www.idiotajezusa.pl/missa" target="_blank" class="cactus-link">🌍 Missa</a><br/>
			<span class="project-desc">the Global Eucharistic Presence.</span>
		</li>
	</ul>
</Layout>
