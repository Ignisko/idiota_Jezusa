---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About" lang="en">
	<h1>about me</h1>
	
	<blockquote style="margin-top: 2rem; font-style: italic; opacity: 0.8; border-left: 2px solid var(--text); padding-left: 1rem;">
		"If I have all faith so as to move mountains, but do not have love, I am nothing."<br/>
		<span style="font-size: 0.9em; opacity: 0.8;">- 1 Corinthians 13:2</span>
	</blockquote>
	
	<p style="margin-top: 2rem;">
		hi, i'm Ignacy, based in Poland. i like to learn about product design and sharing love to Jesus.
	</p>

	<h2>contact</h2>
	<form action="https://formsubmit.co/ignacyjanuszek@gmail.com" method="POST" class="contact-form">
		<input type="hidden" name="_subject" value="New message from afoolforjesus.org">
		<div class="form-group">
			<label for="name">name:</label>
			<input type="text" id="name" name="name" required />
		</div>
		<div class="form-group">
			<label for="email">email:</label>
			<input type="email" id="email" name="email" required />
		</div>
		<div class="form-group">
			<label for="message">message:</label>
			<textarea id="message" name="message" rows="4" required></textarea>
		</div>
		<button type="submit">> send</button>
	</form>

	<h2>dedication</h2>
	<p style="opacity: 0.8; font-style: italic;">
		thank you to everyone who supports my work. above all, i am deeply grateful to Jesus, Mary, my Guardian Angel, and all the Saints for their constant presence in my life.
	</p>
	<p style="opacity: 0.8; font-style: italic; margin-top: 1rem;">
		built with Astro. theme inspired by Chris Williams.
	</p>
</Layout>

<style>
	.contact-form {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		max-width: 400px;
		margin-top: 1rem;
		margin-bottom: 2rem;
	}
	.form-group {
		display: flex;
		flex-direction: column;
	}
	.contact-form label {
		font-family: 'VT323', monospace;
		font-size: 1.4rem;
	}
	.contact-form input, .contact-form textarea {
		background: var(--bg);
		border: 2px solid var(--text);
		color: var(--text);
		font-family: 'Courier Prime', monospace;
		padding: 0.5rem;
		font-size: 1rem;
	}
	.contact-form input:focus, .contact-form textarea:focus {
		outline: none;
		border-color: var(--accent);
	}
	.contact-form button {
		background: var(--text);
		color: var(--bg);
		border: none;
		padding: 0.5rem 1rem;
		font-family: 'VT323', monospace;
		font-size: 1.4rem;
		cursor: pointer;
		text-transform: uppercase;
		align-self: flex-start;
	}
	.contact-form button:hover {
		background: var(--accent);
	}
</style>
