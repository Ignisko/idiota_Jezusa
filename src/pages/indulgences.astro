---
import Layout from '../layouts/Layout.astro';
const title = "Indulgences";
---

<Layout title={title} lang="en">
	<div class="indulgences-container">
		<h1>Plenary & Partial Indulgences</h1>
		<p class="intro">
			An indulgence is a remission before God of the temporal punishment due to sins whose guilt has already been forgiven.
			Here you can find a list of standard indulgences and discover which special ones are available today.
		</p>

		<section id="today-special" class="highlight-section" style="display:none;">
			<h2>Special Plenary Indulgence Available Today!</h2>
			<ul id="today-list"></ul>
		</section>

		<section class="columns">
			<div class="col">
				<h2 style="margin-top:0;">Standard Plenary Indulgences (Every Day)</h2>
				<ul>
					<li><strong>Adoration of the Blessed Sacrament</strong> for at least half an hour.</li>
					<li><strong>Pious reading of the Sacred Scripture</strong> for at least half an hour.</li>
					<li><strong>Making the Way of the Cross</strong> (moving from station to station).</li>
					<li><strong>Recitation of the Marian Rosary</strong> (5 decades) in a church, public oratory, family, or religious community.</li>
					<li><strong>Chaplet of Divine Mercy</strong> before the Blessed Sacrament (in Poland).</li>
				</ul>
				<p class="conditions">
					* <em>Conditions for Plenary Indulgence</em>: Be in a state of grace, completely detached from all sin, go to sacramental confession, receive Holy Communion, and pray for the Pope's intentions.
				</p>
			</div>

			<div class="col">
				<h2 style="margin-top:0;">Partial Indulgences (Every Day)</h2>
				<ul>
					<li>Teaching or learning Catholic doctrine.</li>
					<li>Visiting the Blessed Sacrament for adoration.</li>
					<li>Reciting the <em>Magnificat</em> (Wielbi dusza moja Pana).</li>
					<li>Reciting the <em>Anioł Pański</em> (Angelus) or <em>Regina Caeli</em> (Królowo nieba).</li>
					<li>Reciting the <em>Pomnij o Najświętsza Panno Maryjo</em> (Memorare) or <em>Witaj Królowo</em> (Salve Regina).</li>
					<li>Reciting <em>Pod Twoją obronę</em> (Sub Tuum Praesidium).</li>
					<li>Invoking your Guardian Angel (e.g., <em>Aniele Boży</em>).</li>
					<li>Reciting an approved Litany (e.g., Litany of the Sacred Heart).</li>
					<li>Renewing baptismal promises.</li>
					<li>Using a blessed religious object piously.</li>
					<li>Listening to the Word of God (e.g., a homily).</li>
					<li>Making an examination of conscience and act of contrition.</li>
				</ul>
			</div>
		</section>

		<section class="calendar">
			<h2 style="margin-top:0;">Special Plenary Indulgences Calendar</h2>
			<table class="calendar-table">
				<thead>
					<tr>
						<th>Date</th>
						<th>Occasion</th>
						<th>Action</th>
					</tr>
				</thead>
				<tbody id="calendar-body">
				</tbody>
			</table>
		</section>
	</div>

	<script>
		function getEaster(year) {
			const f = Math.floor,
				G = year % 19,
				C = f(year / 100),
				H = (C - f(C / 4) - f((8 * C + 13)/25) + 19 * G + 15) % 30,
				I = H - f(H/28) * (1 - f(29/(H + 1)) * f((21 - G)/11)),
				J = (year + f(year / 4) + I + 2 - C + f(C / 4)) % 7,
				L = I - J,
				month = 3 + f((L + 40)/44),
				day = L + 28 - 31 * f(month / 4);
			return new Date(year, month - 1, day);
		}

		function getChristTheKing(year) {
			const christmas = new Date(year, 11, 25);
			let dayOfWeek = christmas.getDay(); 
			const fourthAdvent = new Date(christmas);
			fourthAdvent.setDate(christmas.getDate() - (dayOfWeek === 0 ? 7 : dayOfWeek));
			const christTheKing = new Date(fourthAdvent);
			christTheKing.setDate(fourthAdvent.getDate() - 28);
			return christTheKing;
		}

		function checkSpecials() {
			const today = new Date();
			const year = today.getFullYear();
			const m = today.getMonth(); // 0-indexed
			const d = today.getDate();
			const dayOfWeek = today.getDay(); // 0 = Sunday, 5 = Friday

			const easter = getEaster(year);
			const ashWed = new Date(easter);
			ashWed.setDate(easter.getDate() - 46);
			const holyThursday = new Date(easter);
			holyThursday.setDate(easter.getDate() - 3);
			const goodFriday = new Date(easter);
			goodFriday.setDate(easter.getDate() - 2);
			const easterVigil = new Date(easter);
			easterVigil.setDate(easter.getDate() - 1);
			const pentecost = new Date(easter);
			pentecost.setDate(easter.getDate() + 49);
			const corpusChristi = new Date(easter);
			corpusChristi.setDate(easter.getDate() + 60);
			const sacredHeart = new Date(easter);
			sacredHeart.setDate(easter.getDate() + 68);
			const christTheKing = getChristTheKing(year);

			const isSameDay = (d1, d2) => d1.getDate() === d2.getDate() && d1.getMonth() === d2.getMonth() && d1.getFullYear() === d2.getFullYear();
			
			const isLent = today >= ashWed && today < holyThursday;
			
			const formatDate = (date) => date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
			const formatDateShort = (date) => date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });

			const calendarEvents = [
				{ id: 'jan1', date: new Date(year, 0, 1), name: 'Jan 1', desc: 'Recite <em>Veni Creator</em> (O Stworzycielu Duchu, przyjdź) publicly.' },
				{ id: 'lent-friday', date: ashWed, name: 'Fridays of Lent', desc: 'Recite <em>Oto ja</em> (Look down upon me, good and gentle Jesus) after Communion before a crucifix.' },
				{ id: 'lent-weekly', date: ashWed, name: 'Once a week in Lent', desc: 'Participate in <em>Gorzkie Żale</em> (in Poland).' },
				{ id: 'holy-thursday', date: holyThursday, name: 'Holy Thursday', desc: 'Recite <em>Przed tak wielkim Sakramentem</em> (Tantum Ergo) during the transfer of the Blessed Sacrament.' },
				{ id: 'good-friday', date: goodFriday, name: 'Good Friday', desc: 'Veneration of the Cross during the solemn liturgy.' },
				{ id: 'easter-vigil', date: easterVigil, name: 'Easter Vigil', desc: 'Renewal of Baptismal Promises during the liturgy.' },
				{ id: 'pentecost', date: pentecost, name: 'Pentecost', desc: 'Recite <em>Veni Creator</em> (O Stworzycielu Duchu, przyjdź) publicly.' },
				{ id: 'corpus-christi', date: corpusChristi, name: 'Corpus Christi', desc: 'Participate in the Eucharistic procession.' },
				{ id: 'sacred-heart', date: sacredHeart, name: 'Solemnity of the Sacred Heart', desc: 'Act of Reparation (<em>O Jezu Najsłodszy</em>) publicly.' },
				{ id: 'peter-paul', date: new Date(year, 5, 29), name: 'Sts. Peter & Paul', desc: 'Use a religious article blessed by the Pope or a bishop, and recite the Creed (<em>Wierzę w Boga</em>).' },
				{ id: 'ignatius', date: new Date(year, 6, 31), name: 'July 31 (St. Ignatius of Loyola)', desc: 'Visit a Jesuit church or oratory and recite Our Father (<em>Ojcze nasz</em>) and Creed (<em>Wierzę w Boga</em>).' },
				{ id: 'portiuncula', date: new Date(year, 7, 2), name: 'Portiuncula', desc: 'Visit a parish/Franciscan church and recite Our Father (<em>Ojcze nasz</em>) and Creed (<em>Wierzę w Boga</em>).' },
				{ id: 'nov1to8', date: new Date(year, 10, 1), name: 'Nov 1-8', desc: 'Visit a cemetery and pray for the dead (applicable only to the souls in purgatory).' },
				{ id: 'nov2', date: new Date(year, 10, 2), name: 'All Souls', desc: 'Visit a church or oratory and recite Our Father (<em>Ojcze nasz</em>) and Creed (<em>Wierzę w Boga</em>) (only for souls in purgatory).' },
				{ id: 'christ-king', date: christTheKing, name: 'Solemnity of Christ the King', desc: 'Act of Dedication of the Human Race to Jesus Christ.' },
				{ id: 'dec31', date: new Date(year, 11, 31), name: 'Dec 31', desc: 'Recite <em>Ciebie Boga wysławiamy</em> (Te Deum) publicly to thank God for the year.' }
			];

			const tbody = document.getElementById('calendar-body');
			
			calendarEvents.sort((a, b) => a.date - b.date).forEach(event => {
				const tr = document.createElement('tr');
				tr.dataset.id = event.id;
				let dateStr = formatDate(event.date);
				
				if (event.id === 'lent-friday' || event.id === 'lent-weekly') {
					dateStr = `${formatDateShort(ashWed)} - ${formatDate(holyThursday)}`;
				} else if (event.id === 'nov1to8') {
					dateStr = `${formatDateShort(new Date(year, 10, 1))} - ${formatDate(new Date(year, 10, 8))}`;
				}

				const isToday = event.id === 'nov1to8' ? (m === 10 && d >= 1 && d <= 8) : 
								event.id === 'lent-friday' ? (isLent && dayOfWeek === 5) : 
								event.id === 'lent-weekly' ? isLent :
								isSameDay(today, event.date);

				if (isToday) {
					tr.classList.add('active-today');
					
					const specialSection = document.getElementById('today-special');
					const specialList = document.getElementById('today-list');
					if (specialSection.style.display === 'none') {
						specialSection.style.display = 'block';
					}
					const li = document.createElement('li');
					li.innerHTML = `<strong>${event.name}</strong>: ${event.desc}`;
					specialList.appendChild(li);
				}

				tr.innerHTML = `
					<td class="date-cell"><strong>${dateStr}</strong></td>
					<td><strong>${event.name}</strong></td>
					<td>${event.desc}</td>
				`;
				tbody.appendChild(tr);
			});
		}
		
		document.addEventListener('DOMContentLoaded', checkSpecials);
	</script>

	<style>
		.indulgences-container {
			max-width: 800px;
			margin: 0 auto;
		}
		.intro {
			font-size: 1.2rem;
			margin-bottom: 2rem;
		}
		.highlight-section {
			background-color: var(--accent);
			color: var(--bg);
			padding: 1.5rem;
			margin-bottom: 2rem;
			box-shadow: 4px 4px 0 var(--text);
			animation: glow 2s infinite alternate;
		}
		.highlight-section h2 {
			color: var(--bg);
			margin-top: 0;
		}
		.columns {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 2rem;
			margin-bottom: 2rem;
		}
		@media (max-width: 600px) {
			.columns { grid-template-columns: 1fr; }
		}
		.col {
			background-color: rgba(0,0,0,0.02);
			padding: 1.5rem;
			border: 2px solid var(--text);
			box-shadow: 4px 4px 0 var(--text);
		}
		:root[data-theme="dark"] .col {
			background-color: rgba(255,255,255,0.02);
		}
		.conditions {
			font-size: 0.9rem;
			opacity: 0.8;
			margin-top: 1rem;
			border-top: 1px dashed var(--text);
			padding-top: 1rem;
		}
		ul {
			list-style-type: square;
			padding-left: 1.2rem;
		}
		li {
			margin-bottom: 0.8rem;
		}
		.calendar {
			border: 2px solid var(--text);
			padding: 1.5rem;
			box-shadow: 4px 4px 0 var(--text);
			overflow-x: auto;
		}
		.calendar-table {
			width: 100%;
			border-collapse: collapse;
			margin-top: 1rem;
		}
		.calendar-table th, .calendar-table td {
			border: 1px solid var(--text);
			padding: 0.8rem;
			text-align: left;
			vertical-align: top;
		}
		.calendar-table th {
			background-color: rgba(0,0,0,0.05);
			font-family: 'VT323', monospace;
			font-size: 1.4rem;
		}
		:root[data-theme="dark"] .calendar-table th {
			background-color: rgba(255,255,255,0.05);
		}
		.date-cell {
			white-space: nowrap;
			color: var(--accent);
		}
		.active-today {
			color: var(--bg);
			background-color: var(--link);
		}
		.active-today td {
			border-color: var(--bg);
		}
		.active-today .date-cell {
			color: var(--bg);
		}
		@keyframes glow {
			from { box-shadow: 4px 4px 0 var(--text); }
			to { box-shadow: 4px 4px 15px var(--title); }
		}
	</style>
</Layout>
