---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Strona główna" lang="pl">
	<h1>Jezu, ufam Tobie</h1>
	
	<p style="margin-bottom: 2rem;">
		hej, jestem Ignacy, skupiam się na rozwijaniu swojej wiary i dzieleniu się miłością do Jezusa.
	</p>

	<h2>Polecane projekty</h2>
	
	<ul class="project-list" role="list">
		<li class="project-card">
			<div class="project-header">
				<a href="https://stellamaris.help/" target="_blank" class="cactus-link project-title">⭐ Stella Maris</a>
				<span class="project-status status-live">Live</span>
			</div>
			<span class="project-desc">Atlas objawień maryjnych na całym świecie.</span>
		</li>
		<li class="project-card">
			<div class="project-header">
				<a href="https://road2wyd.com/" target="_blank" class="cactus-link project-title">🗺️ World Youth Day Map</a>
				<span class="project-status status-live">Live</span>
			</div>
			<span class="project-desc">Vademecum historii ŚDM przez dekady i kontynenty.</span>
		</li>
		<li class="project-card">
			<div class="project-header">
				<a href="http://eucharisticmiracles.info/" target="_blank" class="cactus-link project-title">🥖 Eucharistic Miracles</a>
				<span class="project-status status-live">Live</span>
			</div>
			<span class="project-desc">Eucharystyczne cuda z całego świata, rzeczywiście udokumentowane.</span>
		</li>
	</ul>
	
	<div style="margin-top: 1.5rem; text-align: right;">
		<a href="/pl/projects" class="cactus-link">Zobacz wszystkie projekty &rarr;</a>
	</div>

	<h2 style="margin-top: 3rem;">Najnowsze artykuły</h2>
	
	<ul class="project-list" role="list">
		<li class="project-card">
			<div class="project-header">
				<a href="/pl/odpusty" class="cactus-link project-title">📜 Odpusty</a>
				<span class="project-status status-live">Live</span>
			</div>
			<span class="project-desc">Przewodnik po katolickich odpustach oraz interaktywny kalendarz, dzięki któremu sprawdzisz, jaki specjalny odpust zupełny jest dostępny dzisiaj.</span>
		</li>
	</ul>
	
	<div style="margin-top: 1.5rem; text-align: right;">
		<a href="/pl/articles" class="cactus-link">Zobacz wszystkie artykuły &rarr;</a>
	</div>
</Layout>
