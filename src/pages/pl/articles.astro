---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Artykuły" lang="pl">
	<h1>Wszystkie Artykuły</h1>
	
	<p style="margin-bottom: 2rem;">
		Kolekcja moich tekstów, przewodników i zasobów.
	</p>
	
	<ul class="project-list" role="list">
		<li class="project-card">
			<div class="project-header">
				<a href="/pl/odpusty" class="cactus-link project-title">📜 Odpusty</a>
				<span class="project-status status-live">Live</span>
			</div>
			<span class="project-desc">Przewodnik po katolickich odpustach oraz interaktywny kalendarz, dzięki któremu sprawdzisz, jaki specjalny odpust zupełny jest dostępny dzisiaj.</span>
			<div class="project-tags">
				<span class="tag">guide</span>
				<span class="tag">faith</span>
			</div>
		</li>
	</ul>
</Layout>
