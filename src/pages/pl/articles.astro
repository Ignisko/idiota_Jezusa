---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Artykuły" lang="pl">
	<h1>Wszystkie Artykuły</h1>
	
	<p style="margin-bottom: 2rem;">
		Kolekcja moich tekstów, przewodników i zasobów.
	</p>
	
	<ul class="project-list" role="list">
		<li class="project-card">
			<div class="project-header">
				<a href="/pl/odpusty" class="cactus-link project-title">📜 Odpusty</a>
			</div>
			<span class="project-desc">Przewodnik po odpustach oraz interaktywny kalendarz.</span>
			<div class="project-tags">
				<span class="tag">guide</span>
				<span class="tag">faith</span>
			</div>
		</li>
		<li class="project-card">
			<div class="project-header">
				<a href="/pl/eucharystia" class="cactus-link project-title">✝ Msza Święta i Eucharystia</a>
			</div>
			<span class="project-desc">Cytaty Świętych o Mszy Świętej i Komunii, słowa św. Faustyny z Dzienniczka, oraz praktyczny przewodnik: jak się przygotować i jak dziękować po Komunii.</span>
			<div class="project-tags">
				<span class="tag">faith</span>
				<span class="tag">eucharist</span>
			</div>
		</li>
	</ul>
</Layout>
