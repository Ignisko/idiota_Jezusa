---
import Layout from '../../layouts/Layout.astro';
const title = "Odpusty";
---

<Layout title={title} lang="pl">
	<div class="indulgences-container">
		<h1>Odpusty Zupełne i Cząstkowe</h1>
		<p class="intro">
			Odpust jest to darowanie przed Bogiem kary doczesnej za grzechy, zgładzone już co do winy. 
			Tutaj znajdziesz listę standardowych odpustów oraz sprawdzisz, jakie specjalne odpusty są dostępne dzisiaj.
		</p>

		<section id="today-special" class="highlight-section" style="display:none;">
			<h2>Specjalny Odpust Zupełny Dostępny Dzisiaj!</h2>
			<ul id="today-list"></ul>
		</section>

		<section class="columns">
			<div class="col">
				<h2 style="margin-top:0;">Standardowe Odpusty Zupełne (Każdego Dnia)</h2>
				<ul>
					<li><strong>Adoracja Najświętszego Sakramentu</strong> przez co najmniej pół godziny.</li>
					<li><strong>Pobożne czytanie Pisma Świętego</strong> przez co najmniej pół godziny.</li>
					<li><strong>Odprawienie Drogi Krzyżowej</strong> (przechodząc od stacji do stacji).</li>
					<li><strong>Odmówienie Różańca</strong> (5 dziesiątków) w kościele, publicznej kaplicy, w rodzinie lub wspólnocie zakonnej.</li>
					<li><strong>Koronka do Miłosierdzia Bożego</strong> przed Najświętszym Sakramentem (w Polsce).</li>
				</ul>
				<p class="conditions">
					* <em>Warunki uzyskania odpustu zupełnego</em>: Stan łaski uświęcającej, brak przywiązania do jakiegokolwiek grzechu, spowiedź sakramentalna, przyjęcie Komunii Świętej oraz modlitwa w intencjach Papieża.
				</p>
			</div>

			<div class="col">
				<h2 style="margin-top:0;">Odpusty Cząstkowe (Każdego Dnia)</h2>
				<ul>
					<li>Nauczanie lub uczenie się prawd wiary katolickiej.</li>
					<li>Nawiedzenie Najświętszego Sakramentu w celu adoracji.</li>
					<li>Odmówienie kantyku <em>Magnificat</em>.</li>
					<li>Odmówienie <em>Anioł Pański</em> lub <em>Regina Caeli</em>.</li>
					<li>Odmówienie modlitwy <em>Pomnij o Najświętsza Panno Maryjo</em> lub <em>Witaj Królowo</em>.</li>
					<li>Odmówienie <em>Pod Twoją obronę</em>.</li>
					<li>Wezwanie swojego Anioła Stróża (np. <em>Aniele Boży</em>).</li>
					<li>Odmówienie zatwierdzonej Litanii (np. do Najświętszego Serca Pana Jezusa).</li>
					<li>Odnowienie przyrzeczeń chrzcielnych.</li>
					<li>Pobożne używanie poświęconego przedmiotu kultu religijnego.</li>
					<li>Słuchanie Słowa Bożego (np. kazania).</li>
					<li>Rachunek sumienia i wzbudzenie aktu żalu.</li>
				</ul>
			</div>
		</section>

		<section class="calendar">
			<h2 style="margin-top:0;">Kalendarz Specjalnych Odpustów Zupełnych</h2>
			<table class="calendar-table">
				<thead>
					<tr>
						<th>Data</th>
						<th>Okazja</th>
						<th>Czynność</th>
					</tr>
				</thead>
				<tbody id="calendar-body">
				</tbody>
			</table>
		</section>
	</div>

	<script>
		function getEaster(year) {
			const f = Math.floor,
				G = year % 19,
				C = f(year / 100),
				H = (C - f(C / 4) - f((8 * C + 13)/25) + 19 * G + 15) % 30,
				I = H - f(H/28) * (1 - f(29/(H + 1)) * f((21 - G)/11)),
				J = (year + f(year / 4) + I + 2 - C + f(C / 4)) % 7,
				L = I - J,
				month = 3 + f((L + 40)/44),
				day = L + 28 - 31 * f(month / 4);
			return new Date(year, month - 1, day);
		}

		function getChristTheKing(year) {
			const christmas = new Date(year, 11, 25);
			let dayOfWeek = christmas.getDay(); 
			const fourthAdvent = new Date(christmas);
			fourthAdvent.setDate(christmas.getDate() - (dayOfWeek === 0 ? 7 : dayOfWeek));
			const christTheKing = new Date(fourthAdvent);
			christTheKing.setDate(fourthAdvent.getDate() - 28);
			return christTheKing;
		}

		function checkSpecials() {
			const today = new Date();
			const year = today.getFullYear();
			const m = today.getMonth(); // 0-indexed
			const d = today.getDate();
			const dayOfWeek = today.getDay(); // 0 = Sunday, 5 = Friday

			const easter = getEaster(year);
			const ashWed = new Date(easter);
			ashWed.setDate(easter.getDate() - 46);
			const holyThursday = new Date(easter);
			holyThursday.setDate(easter.getDate() - 3);
			const goodFriday = new Date(easter);
			goodFriday.setDate(easter.getDate() - 2);
			const easterVigil = new Date(easter);
			easterVigil.setDate(easter.getDate() - 1);
			const pentecost = new Date(easter);
			pentecost.setDate(easter.getDate() + 49);
			const corpusChristi = new Date(easter);
			corpusChristi.setDate(easter.getDate() + 60);
			const sacredHeart = new Date(easter);
			sacredHeart.setDate(easter.getDate() + 68);
			const christTheKing = getChristTheKing(year);

			const isSameDay = (d1, d2) => d1.getDate() === d2.getDate() && d1.getMonth() === d2.getMonth() && d1.getFullYear() === d2.getFullYear();
			
			const isLent = today >= ashWed && today < holyThursday;
			
			const formatDate = (date) => date.toLocaleDateString('pl-PL', { month: 'long', day: 'numeric', year: 'numeric' });
			const formatDateShort = (date) => date.toLocaleDateString('pl-PL', { month: 'long', day: 'numeric' });

			const calendarEvents = [
				{ id: 'jan1', date: new Date(year, 0, 1), name: '1 stycznia (Nowy Rok)', desc: 'Publiczne odmówienie hymnu <em>Veni Creator</em>.' },
				{ id: 'lent-friday', date: ashWed, name: 'Piątki Wielkiego Postu', desc: 'Odmówienie modlitwy <em>"Oto ja"</em> po Komunii przed wizerunkiem Ukrzyżowanego.' },
				{ id: 'lent-weekly', date: ashWed, name: 'Raz w tygodniu w Wielkim Poście', desc: 'Udział w <em>Gorzkich Żalach</em> (w Polsce).' },
				{ id: 'holy-thursday', date: holyThursday, name: 'Wielki Czwartek', desc: 'Uroczyste odmówienie <em>Przed tak wielkim Sakramentem</em>.' },
				{ id: 'good-friday', date: goodFriday, name: 'Wielki Piątek', desc: 'Ucałowanie i adoracja Krzyża w trakcie liturgii.' },
				{ id: 'easter-vigil', date: easterVigil, name: 'Wigilia Paschalna', desc: 'Odnowienie przyrzeczeń chrzcielnych w trakcie liturgii.' },
				{ id: 'pentecost', date: pentecost, name: 'Zesłanie Ducha Świętego', desc: 'Publiczne odmówienie hymnu <em>Veni Creator</em>.' },
				{ id: 'corpus-christi', date: corpusChristi, name: 'Boże Ciało', desc: 'Udział w procesji eucharystycznej.' },
				{ id: 'sacred-heart', date: sacredHeart, name: 'Uroczystość Najświętszego Serca Pana Jezusa', desc: 'Publiczne odmówienie aktu wynagrodzenia (<em>O Jezu Najsłodszy</em>).' },
				{ id: 'peter-paul', date: new Date(year, 5, 29), name: '29 czerwca (Św. Piotra i Pawła)', desc: 'Użycie przedmiotu pobłogosławionego przez Papieża lub biskupa i odmówienie Wyznania Wiary.' },
				{ id: 'ignatius', date: new Date(year, 6, 31), name: '31 lipca (Św. Ignacego z Loyoli)', desc: 'Nawiedzenie kościoła lub kaplicy jezuickiej i odmówienie <em>Ojcze nasz</em> i <em>Wierzę w Boga</em>.' },
				{ id: 'portiuncula', date: new Date(year, 7, 2), name: '2 sierpnia (Porcjunkuli)', desc: 'Nawiedzenie kościoła parafialnego lub franciszkańskiego i odmówienie <em>Ojcze nasz</em> i <em>Wierzę w Boga</em>.' },
				{ id: 'nov1to8', date: new Date(year, 10, 1), name: '1-8 listopada', desc: 'Nawiedzenie cmentarza i modlitwa za zmarłych (tylko za dusze w czyśćcu).' },
				{ id: 'nov2', date: new Date(year, 10, 2), name: '2 listopada (Dzień Zaduszny)', desc: 'Nawiedzenie kościoła lub kaplicy i odmówienie <em>Ojcze nasz</em> i <em>Wierzę w Boga</em> (tylko za dusze w czyśćcu).' },
				{ id: 'christ-king', date: christTheKing, name: 'Uroczystość Chrystusa Króla', desc: 'Odmówienie aktu oddania rodzaju ludzkiego.' },
				{ id: 'dec31', date: new Date(year, 11, 31), name: '31 grudnia', desc: 'Publiczne odśpiewanie hymnu <em>Ciebie Boga wysławiamy (Te Deum)</em>.' }
			];

			const tbody = document.getElementById('calendar-body');
			
			calendarEvents.sort((a, b) => a.date - b.date).forEach(event => {
				const tr = document.createElement('tr');
				tr.dataset.id = event.id;
				let dateStr = formatDate(event.date);
				
				if (event.id === 'lent-friday' || event.id === 'lent-weekly') {
					dateStr = `${formatDateShort(ashWed)} - ${formatDate(holyThursday)}`;
				} else if (event.id === 'nov1to8') {
					dateStr = `${formatDateShort(new Date(year, 10, 1))} - ${formatDate(new Date(year, 10, 8))}`;
				}

				const isToday = event.id === 'nov1to8' ? (m === 10 && d >= 1 && d <= 8) : 
								event.id === 'lent-friday' ? (isLent && dayOfWeek === 5) : 
								event.id === 'lent-weekly' ? isLent :
								isSameDay(today, event.date);

				if (isToday) {
					tr.classList.add('active-today');
					
					const specialSection = document.getElementById('today-special');
					const specialList = document.getElementById('today-list');
					if (specialSection.style.display === 'none') {
						specialSection.style.display = 'block';
					}
					const li = document.createElement('li');
					li.innerHTML = `<strong>${event.name}</strong>: ${event.desc}`;
					specialList.appendChild(li);
				}

				tr.innerHTML = `
					<td class="date-cell"><strong>${dateStr}</strong></td>
					<td><strong>${event.name}</strong></td>
					<td>${event.desc}</td>
				`;
				tbody.appendChild(tr);
			});
		}
		
		document.addEventListener('DOMContentLoaded', checkSpecials);
	</script>

	<style>
		.indulgences-container {
			max-width: 800px;
			margin: 0 auto;
		}
		.intro {
			font-size: 1.2rem;
			margin-bottom: 2rem;
		}
		.highlight-section {
			background-color: var(--accent);
			color: var(--bg);
			padding: 1.5rem;
			margin-bottom: 2rem;
			box-shadow: 4px 4px 0 var(--text);
			animation: glow 2s infinite alternate;
		}
		.highlight-section h2 {
			color: var(--bg);
			margin-top: 0;
		}
		.columns {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 2rem;
			margin-bottom: 2rem;
		}
		@media (max-width: 600px) {
			.columns { grid-template-columns: 1fr; }
		}
		.col {
			background-color: rgba(0,0,0,0.02);
			padding: 1.5rem;
			border: 2px solid var(--text);
			box-shadow: 4px 4px 0 var(--text);
		}
		:root[data-theme="dark"] .col {
			background-color: rgba(255,255,255,0.02);
		}
		.conditions {
			font-size: 0.9rem;
			opacity: 0.8;
			margin-top: 1rem;
			border-top: 1px dashed var(--text);
			padding-top: 1rem;
		}
		ul {
			list-style-type: square;
			padding-left: 1.2rem;
		}
		li {
			margin-bottom: 0.8rem;
		}
		.calendar {
			border: 2px solid var(--text);
			padding: 1.5rem;
			box-shadow: 4px 4px 0 var(--text);
			overflow-x: auto;
		}
		.calendar-table {
			width: 100%;
			border-collapse: collapse;
			margin-top: 1rem;
		}
		.calendar-table th, .calendar-table td {
			border: 1px solid var(--text);
			padding: 0.8rem;
			text-align: left;
			vertical-align: top;
		}
		.calendar-table th {
			background-color: rgba(0,0,0,0.05);
			font-family: 'VT323', monospace;
			font-size: 1.4rem;
		}
		:root[data-theme="dark"] .calendar-table th {
			background-color: rgba(255,255,255,0.05);
		}
		.date-cell {
			white-space: nowrap;
			color: var(--accent);
		}
		.active-today {
			color: var(--bg);
			background-color: var(--link);
		}
		.active-today td {
			border-color: var(--bg);
		}
		.active-today .date-cell {
			color: var(--bg);
		}
		@keyframes glow {
			from { box-shadow: 4px 4px 0 var(--text); }
			to { box-shadow: 4px 4px 15px var(--title); }
		}
	</style>
</Layout>
