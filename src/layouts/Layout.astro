---
const { title } = Astro.props;
---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Idiota Jezusa</title>
		<link href="https://fonts.googleapis.com/css2?family=VT323&family=Courier+Prime:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
		<script is:inline>
			const theme = localStorage.getItem('theme') || 'light';
			document.documentElement.setAttribute('data-theme', theme);
		</script>
		<style is:global>
			:root {
				/* Solarized Light (Base) */
				--bg: #fdf6e3;
				--text: #586e75;
				--accent: #268bd2;
				--link: #d33682;
				--title: #b58900;
			}
			:root[data-theme="dark"] {
				/* Solarized Dark */
				--bg: #002b36;
				--text: #839496;
				--accent: #2aa198;
				--link: #268bd2;
				--title: #b58900;
			}
			* {
				box-sizing: border-box;
			}
			body {
				margin: 0;
				background-color: var(--bg);
				color: var(--text);
				font-family: 'Courier Prime', monospace;
				font-size: 1.15rem;
				line-height: 1.6;
			}
			h1, h2, h3, .title {
				font-family: 'VT323', monospace;
				color: var(--title);
				font-weight: 400;
				letter-spacing: -1px;
			}
			h1 {
				font-size: 1.8rem;
				margin-bottom: 2rem;
				color: var(--accent);
			}
			h2 {
				font-size: 1.2rem;
				margin-top: 3rem;
				margin-bottom: 1rem;
			}
			a {
				color: var(--link);
				text-decoration: none;
			}
			a:hover {
				text-decoration: underline;
			}
			main {
				max-width: 800px;
				margin: 0 auto;
				padding: 3rem 1.5rem;
			}
			header {
				display: flex;
				align-items: center;
				margin-bottom: 4rem;
				gap: 1.5rem;
			}
			.logo-container {
				position: relative;
				width: 80px;
				height: 80px;
			}
			.logo-bw, .logo-color {
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				transition: opacity 0.3s ease;
			}
			.logo-color {
				opacity: 0;
			}
			.logo-container:hover .logo-color {
				opacity: 1;
			}
			.logo-container:hover .logo-bw {
				opacity: 0;
			}
			nav {
				display: flex;
				gap: 1.5rem;
				font-family: 'VT323', monospace;
				font-weight: 400;
				font-size: 1.2rem;
			}
			footer {
				margin-top: 5rem;
				text-align: center;
				font-size: 1.2rem;
				opacity: 0.7;
			}
			ul {
				padding-left: 1rem;
				list-style-type: square;
			}
			li {
				margin-bottom: 1.5rem;
			}
			.project-desc {
				font-size: 1.2rem;
				opacity: 0.8;
				display: block;
				margin-top: 0.2rem;
			}
		</style>
	</head>
	<body>
		<main>
			<header>
				<a href="/">
					<div class="logo-container">
						<img src="/images/Cross-b_w-removebg.png" alt="Cross Black and White" class="logo-bw" />
						<img src="/images/Cross-color-removebg.png" alt="Cross Color" class="logo-color" />
					</div>
				</a>
				<div>
					<div class="title" style="margin-bottom: 0.8rem; font-size: 1.5rem; color: var(--text);">Idiota Jezusa</div>
					<nav>
						<a href="/">Home</a>
						<a href="/about">About</a>
						<button id="theme-toggle" style="background: none; border: none; cursor: pointer; color: var(--text); padding: 0; font-family: inherit; font-size: inherit;">
							🌙
						</button>
					</nav>
				</div>
			</header>
			<slot />
			<footer>
				&copy; 2026 Ignacy. Theme inspired by Chris Williams ✝️
			</footer>
		</main>
		<script is:inline>
			const toggleBtn = document.getElementById('theme-toggle');
			const html = document.documentElement;
			
			// Set initial icon
			if (html.getAttribute('data-theme') === 'dark') {
				toggleBtn.textContent = '🌞';
			}

			toggleBtn.addEventListener('click', () => {
				const currentTheme = html.getAttribute('data-theme') || 'light';
				const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
				html.setAttribute('data-theme', newTheme);
				localStorage.setItem('theme', newTheme);
				toggleBtn.textContent = newTheme === 'dark' ? '🌞' : '🌙';
			});
		</script>
	</body>
</html>
