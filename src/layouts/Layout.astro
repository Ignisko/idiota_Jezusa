---
const { title, lang = 'en' } = Astro.props;

const isPl = lang === 'pl';
const homeLink = isPl ? '/pl/' : '/';
const aboutLink = isPl ? '/pl/about' : '/about';
const homeText = isPl ? 'Strona główna' : 'Home';
const aboutText = isPl ? 'O mnie' : 'About';

let currentPath = Astro.url.pathname;
if (currentPath.length > 1 && currentPath.endsWith('/')) {
	currentPath = currentPath.slice(0, -1);
}

let alternatePath;
if (isPl) {
	alternatePath = currentPath.replace(/^\/pl/, '');
	if (alternatePath === '') alternatePath = '/';
} else {
	alternatePath = currentPath === '/' ? '/pl/' : `/pl${currentPath}`;
}
---
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Idiota Jezusa</title>
		<link href="https://fonts.googleapis.com/css2?family=VT323&family=Courier+Prime:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
		<script is:inline>
			const theme = localStorage.getItem('theme') || 'light';
			document.documentElement.setAttribute('data-theme', theme);
		</script>
		<style is:global>
			:root {
				/* Solarized Light (Base) */
				--bg: #fdf6e3;
				--text: #586e75;
				--accent: #268bd2;
				--link: #d33682;
				--title: #b58900;
			}
			:root[data-theme="dark"] {
				/* Solarized Dark */
				--bg: #002b36;
				--text: #839496;
				--accent: #2aa198;
				--link: #268bd2;
				--title: #b58900;
			}
			* {
				box-sizing: border-box;
			}
			body {
				margin: 0;
				background-color: var(--bg);
				color: var(--text);
				font-family: 'Courier Prime', monospace;
				font-size: 1.15rem;
				line-height: 1.6;
			}
			h1, h2, h3, .title {
				font-family: 'VT323', monospace;
				color: var(--title);
				font-weight: 400;
				letter-spacing: -1px;
			}
			h1 {
				font-size: 1.8rem;
				margin-bottom: 2rem;
				color: var(--accent);
			}
			h2 {
				font-size: 1.2rem;
				margin-top: 3rem;
				margin-bottom: 1rem;
			}
			a {
				color: var(--link);
				text-decoration: none;
			}
			a:hover {
				text-decoration: underline;
			}
			main {
				max-width: 800px;
				margin: 0 auto;
				padding: 3rem 1.5rem;
			}
			header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-bottom: 4rem;
			}
			.header-left {
				display: flex;
				align-items: center;
				gap: 1.5rem;
			}
			.header-right {
				display: flex;
				align-items: center;
				gap: 1.5rem;
				font-family: 'Courier Prime', monospace;
			}
			.logo-container {
				position: relative;
				width: 80px;
				height: 80px;
			}
			.logo-bw, .logo-color {
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				transition: opacity 0.3s ease;
			}
			:root[data-theme="light"] .logo-bw {
				mix-blend-mode: multiply;
			}
			:root[data-theme="dark"] .logo-bw {
				filter: invert(1);
				mix-blend-mode: screen;
			}
			:root[data-theme="light"] .theme-icon-sun { display: none; }
			:root[data-theme="light"] .theme-icon-moon { display: block; }
			:root[data-theme="dark"] .theme-icon-sun { display: block; }
			:root[data-theme="dark"] .theme-icon-moon { display: none; }
			.logo-color {
				opacity: 0;
			}
			.logo-container:hover .logo-color {
				opacity: 1;
			}
			.logo-container:hover .logo-bw {
				opacity: 0;
			}
			nav {
				display: flex;
				gap: 1.5rem;
				font-family: 'VT323', monospace;
				font-weight: 400;
				font-size: 1.2rem;
			}
			footer {
				margin-top: 5rem;
				text-align: center;
				font-size: 1.2rem;
				opacity: 0.7;
			}
			ul {
				padding-left: 1rem;
				list-style-type: square;
			}
			li {
				margin-bottom: 1.5rem;
			}
			.project-desc {
				font-size: 1.2rem;
				opacity: 0.8;
				display: block;
				margin-top: 0.2rem;
			}
		</style>
	</head>
	<body>
		<main>
			<header>
				<div class="header-left">
					<a href={homeLink}>
						<div class="logo-container">
							<img src="/images/Cross-b_w-removebg.png" alt="Cross Black and White" class="logo-bw" />
							<img src="/images/Cross-color-removebg.png" alt="Cross Color" class="logo-color" />
						</div>
					</a>
					<div>
						<div class="title" style="margin-bottom: 0.8rem; font-size: 1.5rem; color: var(--text);">Idiota Jezusa</div>
						<nav>
							<a href={homeLink}>{homeText}</a>
							<a href={aboutLink}>{aboutText}</a>
						</nav>
					</div>
				</div>
				<div class="header-right">
					<div class="lang-toggle" style="font-size: 1.2rem;">
						<a href={isPl ? alternatePath : '#'} style={isPl ? "opacity: 0.5;" : "font-weight: bold; pointer-events: none; color: var(--text);"}>EN</a>
						<span style="opacity: 0.5;">|</span>
						<a href={!isPl ? alternatePath : '#'} style={!isPl ? "opacity: 0.5;" : "font-weight: bold; pointer-events: none; color: var(--text);"}>PL</a>
					</div>
					<button id="theme-toggle" style="background: none; border: none; cursor: pointer; color: var(--text); padding: 0; display: flex; align-items: center;" aria-label="Toggle Theme">
						<svg class="theme-icon-sun" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
						<svg class="theme-icon-moon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
					</button>
				</div>
			</header>
			<slot />
			<footer>
				&copy; mmxxvi spol.ski ✝️
			</footer>
		</main>
		<script is:inline>
			const toggleBtn = document.getElementById('theme-toggle');
			const html = document.documentElement;

			toggleBtn.addEventListener('click', () => {
				const currentTheme = html.getAttribute('data-theme') || 'light';
				const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
				html.setAttribute('data-theme', newTheme);
				localStorage.setItem('theme', newTheme);
			});
		</script>
	</body>
</html>
