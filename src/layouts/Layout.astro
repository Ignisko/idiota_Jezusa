---
const { title, lang = 'en', hideNav = false, hideHeader = false } = Astro.props;

const isPl = lang === 'pl';
const homeLink = isPl ? '/pl/' : '/';
const aboutLink = isPl ? '/pl/about' : '/about';
const homeText = isPl ? 'Strona główna' : 'Home';
const aboutText = isPl ? 'O mnie' : 'About';

let currentPath = Astro.url.pathname;
if (currentPath.length > 1 && currentPath.endsWith('/')) {
	currentPath = currentPath.slice(0, -1);
}

let alternatePath;
if (isPl) {
	alternatePath = currentPath.replace(/^\/pl/, '');
	if (alternatePath === '') alternatePath = '/';
} else {
	alternatePath = currentPath === '/' ? '/pl/' : `/pl${currentPath}`;
}
---
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Idiota Jezusa</title>
		<link href="https://fonts.googleapis.com/css2?family=VT323&family=Courier+Prime:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
		<script is:inline>
			// Force light mode as default if nothing is saved
			const theme = localStorage.getItem('theme') || 'light';
			document.documentElement.setAttribute('data-theme', theme);
		</script>
		<style is:global>
			:root {
				color-scheme: light;
				/* Solarized Light (Base) */
				--bg: #fdf6e3;
				--text: #586e75;
				--accent: #268bd2;
				--link: #d33682;
				--title: #b58900;
			}
			:root[data-theme="dark"] {
				color-scheme: dark;
				/* Solarized Dark */
				--bg: #002b36;
				--text: #839496;
				--accent: #2aa198;
				--link: #268bd2;
				--title: #b58900;
			}
			* {
				box-sizing: border-box;
			}
			body {
				margin: 0;
				background-color: var(--bg);
				color: var(--text);
				font-family: 'Courier Prime', monospace;
				font-size: 1.15rem;
				line-height: 1.6;
			}
			h1, h2, h3, .title {
				font-family: 'VT323', monospace;
				font-weight: normal;
				letter-spacing: 0.05em;
			}
			h1 {
				font-size: 3.5rem;
				margin-bottom: 1.5rem;
				color: var(--accent);
				line-height: 1.1;
			}
			h2 {
				font-size: 2.2rem;
				margin-top: 3.5rem;
				margin-bottom: 1.2rem;
				color: var(--text);
			}
			a {
				color: var(--link);
				text-decoration: none;
			}
			a:hover {
				text-decoration: underline;
			}
			.cactus-link {
				text-decoration: underline;
				text-underline-offset: 4px;
			}
			.cactus-link:hover {
				text-decoration-thickness: 2px;
			}
			main {
				max-width: 800px;
				margin: 0 auto;
				padding: 3rem 1.5rem;
			}
			header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-bottom: 4rem;
			}
			.header-left {
				display: flex;
				align-items: center;
				gap: 1.5rem;
			}
			.header-right {
				display: flex;
				align-items: center;
				gap: 1.5rem;
				font-family: 'Courier Prime', monospace;
			}
			.logo-container {
				position: relative;
				width: 80px;
				height: 80px;
			}
			.logo-bw, .logo-color {
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				transition: opacity 0.3s ease;
			}
			:root[data-theme="light"] .logo-bw {
				mix-blend-mode: multiply;
			}
			:root[data-theme="dark"] .logo-bw {
				filter: invert(1);
				mix-blend-mode: screen;
			}
			:root[data-theme="light"] .theme-icon-sun { display: none; }
			:root[data-theme="light"] .theme-icon-moon { display: block; }
			:root[data-theme="dark"] .theme-icon-sun { display: block; }
			:root[data-theme="dark"] .theme-icon-moon { display: none; }
			.logo-color {
				opacity: 0;
			}
			.logo-container:hover .logo-color {
				opacity: 1;
			}
			.logo-container:hover .logo-bw {
				opacity: 0;
			}
			nav {
				display: flex;
				gap: 1.5rem;
				font-family: 'VT323', monospace;
				font-weight: 400;
				font-size: 1.2rem;
			}
			footer {
				margin-top: 5rem;
				text-align: center;
				font-size: 1.2rem;
				opacity: 0.7;
			}
			ul {
				padding-left: 1rem;
				list-style-type: square;
			}
			li {
				margin-bottom: 1.5rem;
			}
			.project-desc {
				font-size: 1.2rem;
				opacity: 0.8;
				display: block;
				margin-top: 0.2rem;
			}
			.fish-container {
				margin-top: 0.8rem;
				display: flex;
				justify-content: center;
				align-items: center;
				height: 60px;
				overflow: visible;
			}
			.fish {
				font-family: monospace;
				color: var(--text);
				font-size: 1.2rem;
				cursor: pointer;
				transition: all 0.3s ease;
				display: inline-block;
				user-select: none;
				margin: 0;
			}
			.fish:hover {
				transform: scale(1.1);
			}
			.fish.jump {
				animation: fishJump 0.8s ease-in-out;
			}
			.fish.cross {
				font-family: serif;
				font-size: 2rem;
				font-weight: bold;
				color: var(--accent);
			}
			@keyframes fishJump {
				0% { transform: translateY(0) rotate(0deg); }
				25% { transform: translateY(-40px) rotate(-15deg); }
				50% { transform: translateY(-60px) rotate(0deg); }
				75% { transform: translateY(-40px) rotate(15deg); }
				100% { transform: translateY(0) rotate(0deg); }
			}

			.project-list {
				list-style: none;
				padding: 0;
				display: grid;
				gap: 1.5rem;
			}
			.project-card {
				border: 1px dashed var(--text);
				padding: 1.5rem;
				transition: transform 0.2s, box-shadow 0.2s;
				background-color: var(--bg);
			}
			.project-card:hover {
				transform: translateY(-2px);
				box-shadow: 4px 4px 0 var(--accent);
			}
			.project-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 0.5rem;
			}
			.project-title {
				font-family: 'VT323', monospace;
				font-size: 1.6rem;
			}
			.project-status {
				font-size: 0.9rem;
				opacity: 0.8;
				font-family: 'Courier Prime', monospace;
			}
			.project-tags {
				margin-top: 1rem;
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
			}
			.tag {
				font-size: 0.85rem;
				border: 1px solid var(--text);
				padding: 0.1rem 0.5rem;
				border-radius: 4px;
				opacity: 0.7;
			}
		</style>
	</head>
	<body>
		<main>
			{!hideHeader && (
				<header>
					<div class="header-left">
						<a href={homeLink}>
							<div class="logo-container">
								<img src="/images/Cross-b_w-removebg.png" alt="Cross Black and White" class="logo-bw" />
								<img src="/images/Cross-color-removebg.png" alt="Cross Color" class="logo-color" />
							</div>
						</a>
						<div>
							<div class="title" style="margin-bottom: 0.8rem; font-size: 1.5rem; color: var(--text);">Idiota Jezusa</div>
							{!hideNav && (
								<nav>
									<a href={homeLink}>{homeText}</a>
									<a href={aboutLink}>{aboutText}</a>
								</nav>
							)}
						</div>
					</div>
					<div class="header-right">
						<div class="lang-toggle" style="font-size: 1.2rem;">
							<a href={isPl ? alternatePath : '#'} style={isPl ? "opacity: 0.5; color: var(--text); text-decoration: none;" : "font-weight: bold; pointer-events: none; color: var(--text); text-decoration: none;"}>EN</a>
							<span style="opacity: 0.5; margin: 0 0.3rem;">|</span>
							<a href={!isPl ? alternatePath : '#'} style={!isPl ? "opacity: 0.5; color: var(--text); text-decoration: none;" : "font-weight: bold; pointer-events: none; color: var(--text); text-decoration: none;"}>PL</a>
						</div>
						<button id="theme-toggle" style="background: none; border: none; cursor: pointer; color: var(--text); padding: 0; display: flex; align-items: center;" aria-label="Toggle Theme">
							<svg class="theme-icon-sun" width="24" height="24" viewBox="0 0 16 16" fill="currentColor">
								<rect x="5" y="5" width="6" height="6" />
								<rect x="7" y="1" width="2" height="2" />
								<rect x="7" y="13" width="2" height="2" />
								<rect x="1" y="7" width="2" height="2" />
								<rect x="13" y="7" width="2" height="2" />
								<rect x="3" y="3" width="2" height="2" />
								<rect x="11" y="3" width="2" height="2" />
								<rect x="3" y="11" width="2" height="2" />
								<rect x="11" y="11" width="2" height="2" />
							</svg>
							<svg class="theme-icon-moon" width="24" height="24" viewBox="0 0 16 16" fill="currentColor">
								<rect x="9" y="2" width="4" height="2" />
								<rect x="13" y="4" width="2" height="2" />
								<rect x="7" y="4" width="2" height="2" />
								<rect x="5" y="6" width="2" height="4" />
								<rect x="7" y="10" width="2" height="2" />
								<rect x="9" y="12" width="4" height="2" />
								<rect x="13" y="10" width="2" height="2" />
							</svg>
						</button>
					</div>
				</header>
			)}
			<slot />
			<footer>
				&copy; mmxxvi <a href="https://spol.ski" target="_blank">spol.ski</a>
				<div class="fish-container">
					<pre class="fish" id="fish">>((('></pre>
				</div>
			</footer>
		</main>
		<script is:inline>
			const toggleBtn = document.getElementById('theme-toggle');
			const html = document.documentElement;

			toggleBtn.addEventListener('click', () => {
				const currentTheme = html.getAttribute('data-theme') || 'light';
				const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
				html.setAttribute('data-theme', newTheme);
				localStorage.setItem('theme', newTheme);
			});

			const fish = document.getElementById('fish');
			let hasJumped = false;
			let isCross = false;

			const footerObserver = new IntersectionObserver((entries) => {
				entries.forEach(entry => {
					if (entry.isIntersecting && !hasJumped) {
						fish.classList.add('jump');
						hasJumped = true;
						setTimeout(() => {
							fish.classList.remove('jump');
							hasJumped = false;
						}, 800);
					}
				});
			}, { threshold: 0.5 });

			const footer = document.querySelector('footer');
			if (footer && fish) {
				footerObserver.observe(footer);
			}

			if (fish) {
				fish.addEventListener('click', () => {
					if (isCross) {
						fish.classList.add('jump');
						setTimeout(() => {
							fish.textContent = '>(((\'>';
							fish.classList.remove('cross');
							fish.classList.remove('jump');
							isCross = false;
						}, 400);
					} else {
						fish.classList.add('jump');
						setTimeout(() => {
							fish.textContent = '✝';
							fish.classList.add('cross');
							fish.classList.remove('jump');
							isCross = true;
						}, 800);
					}
				});
			}
		</script>
	</body>
</html>
